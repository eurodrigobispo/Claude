# Domínio que já aponta (registro A) para o IP deste servidor
DOMINIO=apuracao.seudominio.com.br
# E-mail para o certificado HTTPS
EMAIL=voce@seudominio.com.br

# Pedidos simultâneos ao TSE
PARALELO=12
# Cidades com zonas lidas dos boletins: capitais, nenhuma ou lista uf:mun
ZONAS=capitais
# Cargos somados nas zonas e nos locais de votação (sem 6,7 os deputados ficam
# só por município; com eles o coletor usa uns 2 GB de memória)
ZONAS_CARGOS=1,3,5,6,7
# Cargos com matriz por município (sem 6,7 cada navegador lê os deputados do TSE)
MUNICIPIOS=1,3,5,6,7
# Memória máxima do coletor em MB (deixe 1 GB livre para o sistema)
MEMORIA_MB=3072
# Turno: 0 segue o TSE e troca sozinho para o 2º turno; 1 ou 2 força
TURNO=0
