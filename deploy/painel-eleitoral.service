# Alternativa sem Docker: serviço do systemd.
#   sudo cp deploy/painel-eleitoral.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now painel-eleitoral
[Unit]
Description=Painel Eleitoral 2026 (painel + coletor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=painel
WorkingDirectory=/opt/painel-eleitoral
# as mesmas opções do docker-compose.yml; veja a tabela em deploy/IMPLANTACAO.md
ExecStart=/usr/bin/node coletor/servidor.mjs --coletar --porta 8080 --saida /opt/painel-eleitoral/feed --paralelo 12 --zonas capitais --zonas-cargos 1,3,5,6,7 --municipios 1,3,5,6,7 --turno 0
Restart=always
RestartSec=5
Environment=NODE_ENV=production
# com deputados nas zonas das capitais o coletor passa de 2 GB
Environment=NODE_OPTIONS=--max-old-space-size=3072

[Install]
WantedBy=multi-user.target
